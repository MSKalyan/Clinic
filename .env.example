# AI Clinic Operations Assistant - Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# GENERAL
# =============================================================================
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
DJANGO_SECRET_KEY=insecure-dev-secret-key-change-me
DJANGO_LOG_LEVEL=DEBUG

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_NAME=clinic
DB_USER=clinic_app
DB_PASSWORD=clinic_app
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# =============================================================================
# REDIS & CELERY
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# =============================================================================
# AUTH & SECURITY
# =============================================================================
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
INTERNAL_SERVICE_TOKEN_PEPPER=change-me-in-production
# Encrypts the provider credentials each clinic sets for itself.
# Leave empty in development: the key is then derived from the pepper above.
# In production, set it explicitly and never change it -- changing it makes
# every stored clinic secret unreadable.
SECRET_ENCRYPTION_KEY=

# =============================================================================
# ROW LEVEL SECURITY
# =============================================================================
ENABLE_ROW_LEVEL_SECURITY=True

# =============================================================================
# SARVAM AI (Voice Agent)
# =============================================================================
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_API_KEY=
SARVAM_VOICE_AGENT_ID=
SARVAM_WEBHOOK_SECRET=

# =============================================================================
# WHATSAPP BUSINESS API (Meta)
# =============================================================================
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# =============================================================================
# TELEPHONY PROVIDER (Twilio, Plivo, etc.)
# =============================================================================
TELEPHONY_BASE_URL=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PROVIDER=stub

# =============================================================================
# WAHA (self-hosted WhatsApp HTTP API) - local Docker integration
# =============================================================================
# Use http://waha:3000 inside Docker (shared network) or http://localhost:3000
# when Django runs on the host. NEVER expose the API key to the frontend.
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=session_01
# Which clinic this WhatsApp number serves. Used for senders we have not seen
# before; an existing patient's own clinic always takes priority.
WAHA_CLINIC_SLUG=
# Emergency stop for all automated outbound messages (set false to pause).
AUTOMATED_MESSAGING_ENABLED=true
# Must match WHATSAPP_HOOK_CUSTOM_HEADERS in waha/.env
WAHA_WEBHOOK_SECRET=
# Optional: must match WHATSAPP_HOOK_HMAC_KEY in waha/.env
WAHA_WEBHOOK_HMAC_KEY=
WAHA_REQUEST_TIMEOUT_SECONDS=10

# =============================================================================
# FRONTEND
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
